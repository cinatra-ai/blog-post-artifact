{
  "name": "@cinatra-ai/blog-post-artifact",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "src",
    "skills"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.0.0"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "displayName": "Blog Post",
    "roles": [
      "artifact-blog-post-body"
    ],
    "dependencies": [],
    "artifact": {
      "accepts": {
        "file": {
          "mimeTypes": [
            "text/markdown"
          ]
        }
      },
      "skills": {
        "matchers": [
          "@cinatra-ai/blog-post-artifact:blog-post-matcher"
        ]
      },
      "matcherConfidenceThreshold": 0.7
    }
  }
}
